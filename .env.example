SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
DISCORD_WEBHOOK_URL=your_discord_webhook_here

# Optional: myUMBC login for authenticated event scraping
MYUMBC_USER=your_umbc_email
MYUMBC_PASS=your_password
# Set MYUMBC_HEADED=1 to show browser (for Duo/MFA completion)
# MYUMBC_HEADED=1
# Optional: persist authenticated browser session/cookies between runs
# MYUMBC_SESSION_FILE=.auth/myumbc_storage_state.json
